# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_password_here
MONGO_INITDB_DATABASE=omnivise_iot
MONGO_PORT=27017

# Mongo Express Configuration (local development only)
MONGO_EXPRESS_PORT=8081

# Backend Configuration
# REST + WebSocket server port (default 8080)
BACKEND_PORT=8080

# Frontend Configuration
# Nginx reverse proxy port (default 3000)
FRONTEND_PORT=3000

# Sensor Simulator Configuration
# Numeric simulator settings use strict integer parsing; malformed values fail
# startup. Interval between ticks in seconds (integer >= 1, default 5).
SIMULATOR_INTERVAL=5

# Anomaly mode: exact token true or false after trimming (default false).
# Any other value fails simulator startup.
SIMULATOR_ANOMALY_MODE=false

# Anomaly trigger frequency in ticks (integer >= 1, default 60)
SIMULATOR_ANOMALY_EVERY_TICKS=60

# ACTIVE duration in ticks (integer >= 1, default 6)
SIMULATOR_ANOMALY_DURATION_TICKS=6

# Optional RECOVERY duration in ticks (integer >= 1). Blank preserves legacy
# behavior by deriving max(2, SIMULATOR_ANOMALY_DURATION_TICKS / 2).
SIMULATOR_ANOMALY_RECOVERY_TICKS=

# Maximum simultaneous ACTIVE/RECOVERY anomalies (integer 1..2, default 1)
SIMULATOR_MAX_CONCURRENT_ANOMALIES=1

# All numeric anomaly settings are parsed and range-checked even when anomaly
# mode is false. When enabled, lifecycle capacity must satisfy:
# duration + effective recovery <= every * max concurrent. Equality is valid.

# PRNG seed for deterministic reading generation (default 42)
SIMULATOR_SEED=42

# Optional fixed simulation start instant for reproducible values and timestamps.
# Leave blank to start simulation time at process launch time. Runtime pacing is
# always based on the process clock. ISO-8601 instant, for example:
# SIMULATOR_START_TIME=2026-09-10T00:00:00Z
SIMULATOR_START_TIME=

# Threshold alerting (issue #73)
# Optional outbound webhook. Leave unset or blank to disable (no outbound call
# is ever made). When set it must be an absolute http/https URL; a non-blank but
# malformed value fails backend startup. On every alert firing/resolved
# transition the backend POSTs a compact JSON payload; failures are logged and
# swallowed and never delay or break Change Stream processing.
ALERT_WEBHOOK_URL=
