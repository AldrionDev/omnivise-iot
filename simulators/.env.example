# Sensor Data Simulator environment variables

# MongoDB connection
MONGO_URI=mongodb://mongodb:27017/?replicaSet=rs0
MONGO_DATABASE=omnivise_iot
MONGO_COLLECTION=sensor_readings

# Simulator settings. INTERVAL_SECONDS must be >= 1.
INTERVAL_SECONDS=5

# Anomaly injection (off by default). When enabled, every ANOMALY_EVERY_TICKS
# ticks one device/channel is driven past a breach value for
# ANOMALY_DURATION_TICKS ticks, then recovers. At the default 5s interval this is
# roughly a 30s breach every 5 minutes.
#
# Validated at startup when ANOMALY_MODE=true (the simulator refuses to start
# otherwise): ANOMALY_DURATION_TICKS >= 1, and
#   ANOMALY_EVERY_TICKS > ANOMALY_DURATION_TICKS + max(2, ANOMALY_DURATION_TICKS / 2)
# so the next onset lands in a NORMAL phase and the cadence actually holds.
# With ANOMALY_MODE=false these two values are inert and not checked.
ANOMALY_MODE=false
ANOMALY_EVERY_TICKS=60
ANOMALY_DURATION_TICKS=6

# Deterministic runs: SEED defaults to 42. Set it to any integer to pick a
# different sequence. Unset or blank falls back to 42. A run repeats exactly only
# given the same SEED AND the same start instant.
SEED=42

# Optional fixed simulation start instant for reproducible values and timestamps.
# Leave blank for normal production behavior: start at process launch time. This
# controls simulation time only; runtime pacing always uses the process clock.
# Use an ISO-8601 instant, for example 2026-09-10T00:00:00Z.
START_TIME=
